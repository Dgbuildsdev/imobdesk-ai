generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  USER
}

model Organization {
  id String @id @default(cuid())

  name String

  slug String @unique

  document String?

  phone String?

  email String?

  active Boolean @default(true)

  users User[]

  clients Client[]

  properties Property[]

  processes Process[]

  processTypes ProcessType[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(cuid())

  name String

  email String @unique

  password String

  role Role @default(USER)

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Client {
  id String @id @default(cuid())

  name String

  cpfCnpj String?

  phone String?

  email String?

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  processes Process[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Property {
  id String @id @default(cuid())

  title String

  type String

  address String

  city String

  state String

  registration String?

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  processes Process[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model ProcessType {
  id String @id @default(cuid())

  name String

  description String?

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  processes Process[]

  stages ProcessStage[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model ProcessStage {
  id String @id @default(cuid())

  name String

  order Int

  processTypeId String

  processType ProcessType @relation(fields: [processTypeId], references: [id])

  processes Process[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Process {
  id String @id @default(cuid())

  title String

  status String @default("OPEN")

  processTypeId String

  processType ProcessType @relation(fields: [processTypeId], references: [id])

  currentStageId String?

  currentStage ProcessStage? @relation(fields: [currentStageId], references: [id])

  clientId String

  client Client @relation(fields: [clientId], references: [id])

  propertyId String

  property Property @relation(fields: [propertyId], references: [id])

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  documents Document[]

  tasks Task[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Document {
  id String @id @default(cuid())

  name String

  url String?

  processId String

  process Process @relation(fields: [processId], references: [id])

  createdAt DateTime @default(now())
}

model Task {
  id String @id @default(cuid())

  title String

  completed Boolean @default(false)

  processId String

  process Process @relation(fields: [processId], references: [id])

  createdAt DateTime @default(now())
}
